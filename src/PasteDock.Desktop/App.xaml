<Application x:Class="PasteDock.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PasteDock.Desktop.Converters"
    ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:VisibilityConverter x:Key="Visible" />
      <converters:InverseBooleanConverter x:Key="Not" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
