<Window x:Class="PasteDock.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:controls="clr-namespace:PasteDock.Desktop.Controls"
    Title="PasteDock" Icon="/Assets/PasteDock.ico" Width="1080" Height="700" MinWidth="860" MinHeight="560"
    WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource BodyFont}" FontSize="13"
    UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="WindowPreviewKeyDown" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource SurfaceBrush}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="1" /><RowDefinition /><RowDefinition Height="1" /><RowDefinition Height="42" /></Grid.RowDefinitions>
      <!-- Window chrome -->
      <Grid Margin="18,0,12,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/Assets/PasteDock.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="PasteDock" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="BrandDivider" Text="/" Foreground="{DynamicResource DividerBrush}" Margin="16,0" VerticalAlignment="Center" FontSize="19" />
          <TextBlock x:Name="BrandTagline" Text="Keep your flow." Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Command="{Binding PauseCommand}" ToolTip="{Binding CaptureHint}" Margin="0,0,10,0" Padding="9,5">
            <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding CaptureLabel}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" /></StackPanel>
          </Button>
          <Button x:Name="CommandButton" Style="{StaticResource IconButton}" Content="&#xE945;" Command="{Binding OpenPaletteCommand}" ToolTip="Command menu · Ctrl+K" AutomationProperties.Name="Command menu" />
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}" ToolTip="Settings · Ctrl+," AutomationProperties.Name="Settings" />
          <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="9,7" />
          <Button Style="{StaticResource IconButton}" Content="&#xE738;" Click="HideClick" ToolTip="Hide to tray" AutomationProperties.Name="Hide to tray" />
          <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="HideClick" ToolTip="Close window; capture stays active" AutomationProperties.Name="Close window" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource DividerBrush}" />
      <!-- Three regions, one continuous workspace -->
      <Grid Grid.Row="2" x:Name="WorkspaceGrid">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="174" /><ColumnDefinition x:Name="HistoryColumn" Width="350" MinWidth="270" MaxWidth="600" /><ColumnDefinition Width="12" /><ColumnDefinition MinWidth="300" /></Grid.ColumnDefinitions>
        <Border x:Name="NavigationPane" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
          <Grid Margin="12,20,12,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Workspace" Style="{StaticResource SectionLabel}" Margin="10,0,0,12" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Filters}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="10,9" Margin="0,1">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                    <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                  </Style></Button.Style>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Row="2" Margin="10,24,0,0">
              <TextBlock Text="Your tags" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="Give your clips a home." Style="{StaticResource MutedText}" FontSize="10" Visibility="{Binding AvailableTags.Count, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
            </StackPanel>
            <ScrollViewer Grid.Row="3" Margin="3,0,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding AvailableTags}"><ItemsControl.ItemTemplate><DataTemplate>
                <Button Command="{Binding DataContext.UseTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="8,6">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="#" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding}" FontSize="11" /></StackPanel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="4">
              <Button Content="+  New snippet" Command="{Binding NewSnippetCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,18" ToolTip="New snippet · Ctrl+N" />
              <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,0,8,14" />
              <TextBlock Text="On this device" Style="{StaticResource SectionLabel}" Margin="10,0,0,6" FontSize="9" />
              <TextBlock Text="{Binding StorageLabel}" Style="{StaticResource MutedText}" FontSize="10" Margin="10,0,0,5" />
              <TextBlock Text="{Binding UndoStorageLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,5" Visibility="{Binding UndoStorageLabel, Converter={StaticResource Visible}}" />
              <StackPanel Orientation="Horizontal" Margin="10,0,0,0"><TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,5,0" /><TextBlock Text="Encrypted local history" FontSize="9" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <!-- Search and virtualized history -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="34" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="14,14,8,8">
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,9,30,9" FontSize="12" AutomationProperties.Name="Search clipboard history" />
            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock Text="Search clips, #tags, app:code..." FontSize="11" Margin="33,0,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasSearch, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
            <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" Width="27" Height="27" Margin="0,0,3,0" FontSize="9" Visibility="{Binding HasSearch, Converter={StaticResource Visible}}" ToolTip="Clear search" AutomationProperties.Name="Clear search" />
          </Grid>
          <Grid Grid.Row="1" Margin="18,0,10,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding FilterLabel}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding ResultsLabel}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="8,1,0,0" /></StackPanel>
            <ToggleButton Grid.Column="1" Content="Deep" IsChecked="{Binding DeepSearch}" FontSize="10" Padding="7,2" MinHeight="23" ToolTip="Search full content beyond the instant index. Large histories may take longer." />
          </Grid>
          <ListBox x:Name="HistoryList" Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
              SelectionMode="Extended" ItemContainerStyle="{StaticResource ClipRow}" IsEnabled="{Binding IsBrowsing}"
              SelectionChanged="HistorySelectionChanged" MouseDoubleClick="HistoryDoubleClick"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
              ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Clipboard history">
            <ListBox.ItemTemplate><DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" Width="25" Height="27" CornerRadius="7" VerticalAlignment="Top" Margin="0,1,0,0">
                  <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,2,0,0">
                      <TextBlock Text="&#xE718;" FontFamily="{DynamicResource IconFont}" FontSize="9" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsPinned, Converter={StaticResource Visible}}" Margin="0,0,4,0" />
                      <TextBlock Text="&#xE735;" FontFamily="{DynamicResource IconFont}" FontSize="9" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsFavorite, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,7" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source}" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                      <Border Style="{StaticResource Keycap}" Padding="4,1" Margin="0,0,6,0" Visibility="{Binding QuickKey, Converter={StaticResource Visible}}">
                        <TextBlock FontSize="8" Foreground="{DynamicResource MutedBrush}"><Run Text="Alt "/><Run Text="{Binding QuickKey, Mode=OneWay}" /></TextBlock>
                      </Border>
                      <TextBlock Text="{Binding Age}" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="260" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EmptyHint}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,18" LineHeight="19" />
            <Button Content="Show all history" Command="{Binding ResetViewCommand}" Style="{StaticResource OutlinedButton}" HorizontalAlignment="Center" Visibility="{Binding IsViewFiltered, Converter={StaticResource Visible}}" />
            <Button Content="Resume capture" Command="{Binding PauseCommand}" Style="{StaticResource OutlinedButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding IsPaused, Converter={StaticResource Visible}}" />
          </StackPanel>
          <Border Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8" Visibility="{Binding HasQueue, Converter={StaticResource Visible}}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding QueueLabel}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Next: Ctrl + Alt + N" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0" /></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Next" Command="{Binding QueueNextCommand}" FontSize="10" Padding="6,3" ToolTip="Paste next queued item" />
                <Button Content="Clear" Command="{Binding ClearQueueCommand}" FontSize="10" Padding="6,3" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="True">
          <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><Border Width="1" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Center" /><Border Width="4" Height="34" Background="{DynamicResource DividerBrush}" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></ControlTemplate></GridSplitter.Template>
        </GridSplitter>
        <!-- Inspect, never execute -->
        <Grid Grid.Column="3" Margin="18,18,20,16">
          <Grid Visibility="{Binding HasPreview, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding SelectionLabel}" Style="{StaticResource SectionLabel}" Margin="0,1,0,10" />
              <TextBlock Grid.Column="1" Text="{Binding TargetLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="220" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,15"><TextBlock Text="{Binding SelectedTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SelectedDetails}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
            <Grid Grid.Row="2" Margin="-3,0,0,14"><Grid.Resources>
              <Style x:Key="CompactIcon" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="28" /><Setter Property="Padding" Value="4" /></Style>
              <Style x:Key="CompactToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}"><Setter Property="Width" Value="28" /><Setter Property="Padding" Value="4" /></Style>
            </Grid.Resources><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource CompactToggle}" Content="&#xE718;" IsChecked="{Binding SelectedItem.IsPinned, Mode=OneWay}" Command="{Binding PinCommand}" ToolTip="Pin · Ctrl+P" AutomationProperties.Name="Pin selected clips" />
                <ToggleButton Style="{StaticResource CompactToggle}" Content="&#xE734;" IsChecked="{Binding SelectedItem.IsFavorite, Mode=OneWay}" Command="{Binding FavoriteCommand}" ToolTip="Favorite · Ctrl+B" AutomationProperties.Name="Favorite selected clips" />
                <Button Style="{StaticResource CompactIcon}" Content="&#xE70F;" Command="{Binding EditCommand}" ToolTip="Edit text · Ctrl+E" AutomationProperties.Name="Edit selected text" />
                <Button x:Name="TagButton" Style="{StaticResource CompactIcon}" Content="&#xE8EC;" Command="{Binding OpenTagsCommand}" ToolTip="Add tags · Ctrl+T" AutomationProperties.Name="Tag selected clips" />
                <Button x:Name="MoreButton" Style="{StaticResource CompactIcon}" Content="&#xE712;" Click="MoreClick" ToolTip="More actions" AutomationProperties.Name="More actions" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource CompactIcon}" Content="&#xE8C8;" Command="{Binding CopyCommand}" ToolTip="Copy · Ctrl+C" AutomationProperties.Name="Copy selected clips" Margin="0,0,5,0" />
                <Button Content="Paste  ↵" Command="{Binding PasteCommand}" Style="{StaticResource PrimaryButton}" Padding="10,7" ToolTip="Paste complete content · Enter" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource PanelBrush}" ClipToBounds="True">
              <Grid><Grid.RowDefinitions><RowDefinition Height="37" /><RowDefinition /><RowDefinition Height="32" /></Grid.RowDefinitions>
                <Grid Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedItem.KindLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="2,0,8,0" />
                    <ToggleButton Content="Image" IsChecked="{Binding ShowImage}" Visibility="{Binding HasImage, Converter={StaticResource Visible}}" FontSize="10" MinHeight="24" Padding="6,2" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="A−" Command="{Binding ZoomTextOutCommand}" FontSize="10" Padding="5,1" MinHeight="24" ToolTip="Smaller preview text" />
                    <Button Content="A+" Command="{Binding ZoomTextInCommand}" FontSize="10" Padding="5,1" MinHeight="24" ToolTip="Larger preview text" />
                  </StackPanel>
                </Grid>
                <TextBox x:Name="PreviewTextBox" Grid.Row="1" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                    FontFamily="{DynamicResource MonoFont}" FontSize="{Binding PreviewFontSize}" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Padding="14" Visibility="{Binding ShowText, Converter={StaticResource Visible}}" AutomationProperties.Name="Text preview" />
                <controls:ImageCanvas Grid.Row="1" Image="{Binding PreviewImage}" Visibility="{Binding ShowImage, Converter={StaticResource Visible}}" />
                <TextBlock Grid.Row="1" Text="Loading preview..." FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PreviewBusy, Converter={StaticResource Visible}}" />
                <Grid Grid.Row="2" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding PreviewLengthLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="{Binding ShowText, Converter={StaticResource Visible}}" />
                  <TextBlock Text="Preview scaled · original preserved" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="{Binding ShowImage, Converter={StaticResource Visible}}" />
                  <Button Grid.Column="1" Content="Load more" Command="{Binding ShowMoreCommand}" FontSize="9" Padding="6,2" MinHeight="23" Visibility="{Binding HasMorePreview, Converter={StaticResource Visible}}" />
                </Grid>
              </Grid>
            </Border>
            <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding SelectedItem.TagsLabel}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Extract text" Command="{Binding ExtractTextCommand}" Visibility="{Binding HasImage, Converter={StaticResource Visible}}" Style="{StaticResource OutlinedButton}" FontSize="10" Padding="10,5" ToolTip="Run Windows OCR locally. Requires a local OCR language pack." />
            </Grid>
          </Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="310" Visibility="{Binding HasPreview, Converter={StaticResource Visible}, ConverterParameter=Invert}">
            <Image Source="/Assets/PasteDock.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,22" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Keep your flow." FontSize="29" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="The things you copy deserve a place to land." FontSize="14" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" LineHeight="22" />
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="12,24,12,20" Padding="0,18,0,0">
              <TextBlock Text="Find a clip. Pin what matters. Paste it anywhere.&#10;Everything stays encrypted on this device." FontSize="12" Foreground="{DynamicResource SecondaryBrush}" TextAlignment="Center" LineHeight="21" />
            </Border>
            <Button Content="Create your first snippet" Command="{Binding NewSnippetCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
          </StackPanel>
          <!-- Inline editor replaces the inspector, without an overlay -->
          <Grid Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Snippet editor" Style="{StaticResource SectionLabel}" />
            <TextBlock Grid.Row="1" Text="Make it worth keeping." FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18" />
            <TextBox Grid.Row="2" x:Name="Editor" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="{DynamicResource MonoFont}" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="14" AutomationProperties.Name="Snippet editor" />
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
              <TextBlock Text="Saves plain text. The clipboard stays unchanged." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Command="{Binding CancelEditCommand}" Margin="0,0,7,0" /><Button Content="Save snippet" Style="{StaticResource PrimaryButton}" Command="{Binding SaveEditCommand}" ToolTip="Save · Ctrl+Enter" /></StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
        <!-- Resizable settings drawer; no backdrop or blur -->
        <Border x:Name="SettingsDrawer" Grid.ColumnSpan="4" HorizontalAlignment="Right" Width="410" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
            Visibility="{Binding SettingsOpen, Converter={StaticResource Visible}}" IsVisibleChanged="SettingsVisibilityChanged" Panel.ZIndex="10">
          <Border.RenderTransform><TranslateTransform x:Name="DrawerTranslate" /></Border.RenderTransform>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Thumb Grid.Column="0" Cursor="SizeWE" DragDelta="ResizeSettings">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="4" Height="36" Background="{DynamicResource DividerBrush}" CornerRadius="2" VerticalAlignment="Center" /></Grid></ControlTemplate></Thumb.Template>
            </Thumb>
            <Grid Grid.Column="1" Margin="14,20,22,16">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Make this space yours." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" Command="{Binding CloseSettingsCommand}" VerticalAlignment="Top" AutomationProperties.Name="Close settings" />
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                <StackPanel>
                  <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
                  <CheckBox Content="Capture images" IsChecked="{Binding Settings.CaptureImages}" Style="{StaticResource Switch}" />
                  <CheckBox Content="Capture file references" IsChecked="{Binding Settings.CaptureFiles}" Style="{StaticResource Switch}" />
                  <CheckBox Content="Start with Windows" IsChecked="{Binding Settings.StartWithWindows}" Style="{StaticResource Switch}" />
                  <CheckBox Content="Keep window on top" IsChecked="{Binding Settings.KeepOnTop}" Style="{StaticResource Switch}" />
                  <CheckBox Content="Reduce motion" IsChecked="{Binding Settings.ReducedMotion}" Style="{StaticResource Switch}" />
                  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions><TextBlock Text="Appearance" VerticalAlignment="Center" FontSize="12" /><ComboBox Grid.Column="1" ItemsSource="{Binding Settings.Themes}" SelectedItem="{Binding Settings.Theme}" /></Grid>
                  <TextBlock Text="SHORTCUT" Style="{StaticResource SectionLabel}" Margin="0,26,0,10" />
                  <TextBox x:Name="HotkeyInput" IsReadOnly="True" Text="{Binding Settings.HotkeyLabel, Mode=OneWay}" PreviewKeyDown="CaptureHotkey" ToolTip="Focus this field and press a combination with Ctrl or Alt." AutomationProperties.Name="Global shortcut" />
                  <TextBlock Text="Click the field, then press a new shortcut. Ctrl+Alt+N is reserved for the paste queue." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <TextBlock Text="HISTORY" Style="{StaticResource SectionLabel}" Margin="0,26,0,10" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Maximum items" FontSize="12" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Settings.Capacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Text="Keep for days (0 = forever)" FontSize="12" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.RetentionDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Text="Content budget, MB" FontSize="12" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.StorageMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3" Text="Maximum item, MB" FontSize="12" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.MaxItemMb, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <TextBlock Text="Smaller limits remove oldest unprotected clips when saved. Pins and favorites are kept. Oversized clips are skipped, never shortened." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="16" />
                  <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}" Margin="0,26,0,10" />
                  <CheckBox Content="Skip recognizable secret tokens" IsChecked="{Binding Settings.BlockSecrets}" Style="{StaticResource Switch}" />
                  <TextBlock Text="Best effort, not a password detector. Exclude sensitive apps below." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                  <CheckBox Content="Exclude our pastes from Windows history" IsChecked="{Binding Settings.PreventCloud}" Style="{StaticResource Switch}" />
                  <TextBlock Text="Also requests no cloud clipboard sync for PasteDock writes. Original copies are controlled by Windows and the source app." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,12" />
                  <TextBlock Text="Excluded process names" FontSize="11" Margin="0,0,0,7" /><TextBox Text="{Binding Settings.ExcludedApps, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" FontSize="11" FontFamily="{DynamicResource MonoFont}" />
                  <TextBlock Text="One executable name per line, with or without .exe. New copies only; existing history is unchanged." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <TextBlock Text="PASTE RULES" Style="{StaticResource SectionLabel}" Margin="0,26,0,10" />
                  <TextBlock Text="Always paste text-only into these apps" FontSize="11" Margin="0,0,0,7" />
                  <TextBox Text="{Binding Settings.PlainTextPasteApps, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="82" VerticalScrollBarVisibility="Auto" FontSize="11" FontFamily="{DynamicResource MonoFont}" />
                  <TextBlock Text="One target process per line. Text, code, links, colors and OCR can be flattened automatically; files and images without OCR keep their original format. You can add or remove the current target from the More menu." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <TextBlock Text="ENCRYPTED BACKUP" Style="{StaticResource SectionLabel}" Margin="0,26,0,10" />
                  <PasswordBox x:Name="BackupPassword" AutomationProperties.Name="Backup passphrase" />
                  <TextBlock Text="At least 12 characters for export. The passphrase is not stored. Import merges without deleting existing clips." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10" />
                  <StackPanel Orientation="Horizontal"><Button Content="Export backup" Style="{StaticResource OutlinedButton}" Click="ExportBackup" Margin="0,0,8,0" IsEnabled="{Binding IsWorking, Converter={StaticResource Not}}" /><Button Content="Import backup" Style="{StaticResource OutlinedButton}" Click="ImportBackup" IsEnabled="{Binding IsWorking, Converter={StaticResource Not}}" /></StackPanel>
                  <Button Content="Quit PasteDock" Command="{Binding QuitCommand}" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Left" Margin="-10,22,0,16" />
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Settings.Error}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding Settings.Error, Converter={StaticResource Visible}}" /><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" Background="{DynamicResource DividerBrush}" />
      <Grid Grid.Row="4" Margin="18,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="9,2,3,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasDeletionUndo, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DeletionUndoLabel}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,7,0" />
            <Button Content="Undo" Command="{Binding UndoDeleteCommand}" FontSize="10" FontWeight="SemiBold" Padding="7,3" MinHeight="25" ToolTip="Undo deletion · Ctrl+Z outside text fields" AutomationProperties.Name="Undo last deletion" />
            <Button Content="×" Command="{Binding ForgetDeletionCommand}" FontSize="12" Padding="6,2" MinHeight="25" ToolTip="Discard the encrypted undo copy permanently" AutomationProperties.Name="Discard deletion undo copy" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border Style="{StaticResource Keycap}"><TextBlock Text="{Binding HotkeyLabel}" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" /></Border>
          <Button x:Name="HelpButton" Content="Shortcuts" Command="{Binding OpenHelpCommand}" FontSize="10" Padding="8,3" MinHeight="26" Margin="7,0,0,0" />
        </StackPanel>
      </Grid>
      <!-- Contextual popovers, never a dimmed modal -->
      <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Style="{StaticResource PopupFrame}" PreviewKeyDown="PopoverPreviewKeyDown" Width="264" Padding="6"><StackPanel>
          <Button Content="Paste as plain text" Command="{Binding PlainPasteCommand}" HorizontalContentAlignment="Left" Click="CloseMore" />
          <Button Content="Paste as temporary file" Command="{Binding PasteAsFileCommand}" HorizontalContentAlignment="Left" Click="CloseMore" ToolTip="Creates a short-lived local file in your user profile, marks it temporary/not-indexed, and makes it cleanup-eligible after 24 hours while PasteDock is running or on a later start. Developer text gets a conservative extension such as .cs, .ts, .py or .sql." />
          <Button Content="{Binding TargetPlainRuleLabel}" Command="{Binding TogglePlainTargetCommand}" HorizontalContentAlignment="Left" Click="CloseMore" ToolTip="A deterministic per-app rule. It only removes formatting from text-capable clips and never runs scripts or sends content elsewhere." />
          <Button Content="Add selection to queue" Command="{Binding QueueCommand}" HorizontalContentAlignment="Left" Click="CloseMore" />
          <Button Content="Compare two selected clips" Command="{Binding CompareCommand}" HorizontalContentAlignment="Left" Click="CloseMore" />
          <Button Content="Transform text..." Command="{Binding OpenToolsCommand}" HorizontalContentAlignment="Left" Click="CloseMore" />
          <Button Content="Export original content..." Command="{Binding SaveFileCommand}" HorizontalContentAlignment="Left" Click="CloseMore" />
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="7,5" />
          <Button Content="{Binding ExcludeSourceLabel}" Command="{Binding ExcludeSourceCommand}" HorizontalContentAlignment="Left" Click="CloseMore" ToolTip="Future copies only. Existing history stays until you delete it." />
          <Button Content="{Binding DeleteSourceLabel}" Command="{Binding RequestSourceDeleteCommand}" HorizontalContentAlignment="Left" Click="CloseMore" />
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="7,5" />
          <Button Content="Delete selected..." Command="{Binding RequestDeleteCommand}" HorizontalContentAlignment="Left" Foreground="{DynamicResource DangerBrush}" Click="CloseMore" />
        </StackPanel></Border>
      </Popup>
      <Popup IsOpen="{Binding TagsOpen}" PlacementTarget="{Binding ElementName=TagButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Style="{StaticResource PopupFrame}" PreviewKeyDown="PopoverPreviewKeyDown" Width="290"><StackPanel>
          <TextBlock Text="A place for this clip." FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBlock Text="Add tags to your selection. Existing tags stay." FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <TextBox x:Name="TagInputBox" Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New tags" />
          <TextBlock Text="project, api, research" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,12" />
          <Button Content="Add tags" Command="{Binding AddTagsCommand}" Style="{StaticResource PrimaryButton}" />
          <TextBlock Text="CURRENT CLIP" Style="{StaticResource SectionLabel}" Margin="0,16,0,5" Visibility="{Binding SelectedTags.Length, Converter={StaticResource Visible}}" />
          <ItemsControl ItemsSource="{Binding SelectedTags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Button Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="6,3" Margin="0,2,4,0" MinHeight="24" ToolTip="Remove this tag from the selection">
              <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" FontSize="10" /><TextBlock Text="×" FontSize="10" Margin="6,0,0,0" /></StackPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
      </Popup>
      <Popup IsOpen="{Binding DeleteOpen}" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Style="{StaticResource PopupFrame}" PreviewKeyDown="PopoverPreviewKeyDown" Width="290"><StackPanel>
          <TextBlock Text="{Binding DeleteLabel}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="{Binding DeleteDescription}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Keep" Command="{Binding CancelDeleteCommand}" Margin="0,0,7,0" /><Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource DangerButton}" /></StackPanel>
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,5" />
          <Button Content="Delete permanently" Command="{Binding PermanentDeleteCommand}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Padding="0,6" FontSize="10" />
          <TextBlock Text="Permanent deletion also discards the previous undo copy." FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel></Border>
      </Popup>
      <Popup IsOpen="{Binding ToolsOpen}" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Style="{StaticResource PopupFrame}" PreviewKeyDown="PopoverPreviewKeyDown" Width="380"><StackPanel>
          <TextBlock Text="Transform, without losing the original." FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />
          <ComboBox ItemsSource="{Binding Transforms}" SelectedItem="{Binding SelectedTransform}" DisplayMemberPath="Label" Margin="0,0,0,10" />
          <Button Content="Preview transformation" Command="{Binding TransformCommand}" Style="{StaticResource OutlinedButton}" />
          <TextBox Text="{Binding TransformPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="11" Height="170" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,12,0,0" Visibility="{Binding TransformReady, Converter={StaticResource Visible}}" />
          <TextBlock Text="Preview up to 65,536 characters. Actions use the full result." FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding TransformReady, Converter={StaticResource Visible}}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="{Binding TransformReady, Converter={StaticResource Visible}}"><Button Content="Copy result" Command="{Binding CopyTransformCommand}" Margin="0,0,7,0" /><Button Content="Save as new clip" Command="{Binding SaveTransformCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel>
        </StackPanel></Border>
      </Popup>
      <Popup x:Name="ComparePopup" IsOpen="{Binding CompareOpen}" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Style="{StaticResource PopupFrame}" PreviewKeyDown="PopoverPreviewKeyDown" Width="720" MaxHeight="560"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="Compare clips" FontSize="17" FontWeight="SemiBold" />
          <Grid Grid.Row="1" Margin="0,7,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CompareLeftTitle}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Grid.Column="2" Text="{Binding CompareRightTitle}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Right" />
          </Grid>
          <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CompareSummary}" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox Content="Ignore whitespace" IsChecked="{Binding CompareIgnoreWhitespace}" VerticalAlignment="Center" Margin="0,0,8,0" /><Button Content="Recompare" Command="{Binding RecompareCommand}" Padding="8,4" MinHeight="27" /></StackPanel>
          </Grid>
          <ListBox Grid.Row="3" ItemsSource="{Binding CompareLines}" MinHeight="250" MaxHeight="390"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Line by line text diff">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" />
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Border x:Name="DiffLine" Padding="8,2" MinWidth="640">
              <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsAdded}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger>
                  <DataTrigger Binding="{Binding IsRemoved}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
                </Style.Triggers>
              </Style></Border.Style>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Prefix}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{DynamicResource MonoFont}" FontSize="11" TextWrapping="NoWrap" />
              </Grid>
            </Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Local line diff. Originals are never modified." FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Copy diff" Command="{Binding CopyDiffCommand}" Margin="0,0,7,0" /><Button Content="Save .diff" Command="{Binding SaveDiffCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel>
          </Grid>
        </Grid></Border>
      </Popup>
      <Popup x:Name="PalettePopup" IsOpen="{Binding PaletteOpen}" PlacementTarget="{Binding ElementName=CommandButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="PaletteOpened">
        <Border Style="{StaticResource PopupFrame}" PreviewKeyDown="PopoverPreviewKeyDown" Width="365" Padding="10"><StackPanel>
          <TextBox x:Name="PaletteSearch" Text="{Binding CommandSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,7" AutomationProperties.Name="Search commands" />
          <ItemsControl ItemsSource="{Binding PaletteItems}"><ItemsControl.ItemTemplate><DataTemplate>
            <Button HorizontalContentAlignment="Stretch" Click="PaletteActionClick" Padding="10,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Shortcut}" FontSize="10" Foreground="{DynamicResource MutedBrush}" /></Grid></Button>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
      </Popup>
      <Popup IsOpen="{Binding HelpOpen}" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
        <Border Style="{StaticResource PopupFrame}" PreviewKeyDown="PopoverPreviewKeyDown" Width="420"><StackPanel>
          <TextBlock Text="Less clicking. More doing." FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" />
          <ItemsControl ItemsSource="{Binding Shortcuts}"><ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Style="{StaticResource Keycap}" HorizontalAlignment="Left"><TextBlock Text="{Binding Keys}" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" /></Border><TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Search: #tag  app:code  type:json  is:pinned  is:protected  has:ocr  copies:3  after:2026-01-01  before:2026-02-01" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel></Border>
      </Popup>
    </Grid>
  </Border>
</Window>
